# ============================================================================
# Back-end FastAPI (.env.example)
# Estrutura igual ao .env real, mas com placeholders seguros.
# Railway: defina RAILWAY_DATABASE_URL no painel e cole o restante igual.
# ============================================================================

# ---------------------------
# Debug/logs
# ---------------------------
DEBUG_LOGS=true
DEBUG_AGENT_LOGS=true

# ---------------------------
# Banco de dados
# ---------------------------
DATABASE_URL=postgresql://user:password@host:5432/dbname



# ---------------------------
# CORS (dev)
# ---------------------------
ALLOW_ORIGINS=*
ALLOW_CREDENTIALS=true

# ---------------------------
# Autenticação
# ---------------------------
ACCESS_KEY=tophawks
ACCESS_KEY_HASH=$2b$12$coloque-o-hash-gerado-pelo-bcrypt-aqui
AUTH_SECRET=altere-para-um-segredo-com-32-caracteres
AUTH_TOKEN_TTL_SECONDS=3600
# Para testes automatizados (mesmo valor da passkey real)
TEST_PASSKEY=tophawks

# ---------------------------
# Modelos (padrão)
# ---------------------------
DEFAULT_MODEL_NAME=google/gemini-2.5-flash
DEFAULT_USE_TAVILY=false

# Overrides específicos para LangGraph Studio
STUDIO_MODEL_NAME=google/gemini-2.5-flash
STUDIO_USE_TAVILY=false

# ---------------------------
# Integrações externas
# ---------------------------
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
TAVILY_API_KEY=your-tavily-api-key

# ---------------------------
# Observabilidade
# ---------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=tophawks-genesis
